POSTGRES_DB="a2e_renovation"
POSTGRES_USER="a2e"
POSTGRES_PASSWORD="replace-with-a-long-random-password"
DATABASE_URL="postgresql://a2e:replace-with-a-long-random-password@postgres:5432/a2e_renovation?schema=public"
# Production via Nginx Proxy Manager / No-IP
NEXT_PUBLIC_SITE_URL="https://a2e.ddns.net"
GOOGLE_SITE_VERIFICATION=""
# Local-only test alternative: http://192.168.0.63:3000
ADMIN_EMAIL="admin@ags-a2e.com"
ADMIN_PASSWORD="replace-with-at-least-12-random-characters"
AUTH_SECRET="change-this-long-secret"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_LEADS_ENABLED="false"
# Optional Brevo SMTP API notification for Julien when a PDF is generated.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="devis@a2e-renovation.fr"
BREVO_SENDER_NAME="A2E Renovation"
LEAD_NOTIFICATION_EMAIL="julien.c@ags-a2e.com"
# SMTP alternatif (OVH : ssl0.ovh.net / Gmail : smtp.gmail.com)
SMTP_HOST="ssl0.ovh.net"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
## Production image: use the exact sha-<40-character commit> published by GitHub Actions.
# A2E_IMAGE_TAG is required in Portainer; do not paste this placeholder unchanged.
A2E_IMAGE_TAG="sha-replace-with-published-commit"
# Keep PostgreSQL major 16. For an existing NAS, first record its installed image.
POSTGRES_IMAGE="postgres:16.15-alpine3.23"
A2E_PORT="3000"
A2E_BIND_ADDRESS="0.0.0.0"
# Only when using docker-compose.external-volumes.yml (exact names from preflight).
# A2E_POSTGRES_VOLUME="existing-stack_a2e_postgres"
# A2E_MEDIA_VOLUME="existing-stack_a2e_media"
